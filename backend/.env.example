# AgriChain AI - Environment Configuration Example
PROJECT_NAME="AgriChain AI Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Firebase Admin Configuration
# Option 1: File path to service account json
FIREBASE_CREDENTIALS_PATH=""
# Option 2: Direct environment variables (recommended for production/docker)
FIREBASE_PROJECT_ID="agrichain-ai"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@agrichain-ai.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_URL="https://agrichain-ai-default-rtdb.firebaseio.com"

# Google Gemini API
GEMINI_API_KEY=""

# Route Optimization & Maps
MAPS_API_KEY=""

# Security & CORS
ALLOWED_ORIGINS=["*"]
