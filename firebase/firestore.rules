rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        getUserData().role == 'admin'
      );
    }

    function isFarmer() {
      return hasRole('farmer');
    }

    function isTransporter() {
      return hasRole('transporter');
    }

    function isWarehouseManager() {
      return hasRole('warehouse_manager');
    }

    function isBuyer() {
      return hasRole('buyer');
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Farms collection
    match /farms/{farmId} {
      allow read: if isAuthenticated();
      allow create: if isFarmer() || isAdmin();
      allow update: if (isFarmer() && resource.data.farmerId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // 3. Crop Batches collection
    match /crop_batches/{batchId} {
      allow read: if isAuthenticated();
      allow create: if isFarmer() || isAdmin();
      allow update: if (isFarmer() && resource.data.farmerId == request.auth.uid) || 
                       isTransporter() || 
                       isWarehouseManager() || 
                       isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Shipments collection
    match /shipments/{shipmentId} {
      allow read: if isAuthenticated();
      allow create: if isFarmer() || isTransporter() || isAdmin();
      allow update: if (isTransporter() && resource.data.transporterId == request.auth.uid) || 
                       isWarehouseManager() || 
                       isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Batch Events (Traceability Timeline) - Append-Only Immutable Log
    match /batch_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin(); // Traceability logs should be immutable
    }

    // 6. Risk Predictions - Generated by ML Intelligence Service
    match /risk_predictions/{predictionId} {
      allow read: if isAuthenticated();
      // Only admin or backend service account can write ML predictions
      allow write: if isAdmin();
    }

    // 7. Route Recommendations
    match /route_recommendations/{recommendationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTransporter();
    }

    // 8. Alerts
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 9. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 10. AI Conversations
    match /ai_conversations/{conversationId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 11. Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 12. Analytics
    match /analytics/{metricId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
